---
import '../styles/app.css';
import '../styles/blog.css';
import Header from '../components/sections/Header.astro';
import Footer from '../components/sections/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import { localeMeta } from '../i18n/config.js';

const {
  title,
  description,
  article = false,
  section = 'blog',
  locale = 'en',
  path = '/',
  jsonLd = null,
} = Astro.props;

const meta = localeMeta(locale);
const pageTitle = title.includes('md2pdf') ? title : `${title} — md2pdf`;
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%2310b981'/%3E%3Ctext x='16' y='22' font-size='16' text-anchor='middle' fill='white' font-family='sans-serif' font-weight='800'%3EM%3C/text%3E%3C/svg%3E"
    />
    <meta name="theme-color" content="#07080b" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('md2pdf-theme');
        const isDark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) document.documentElement.dataset.theme = 'dark';
      })();
    </script>
    <SeoHead
      title={pageTitle}
      description={description}
      locale={locale}
      path={path}
      type={article ? 'article' : 'website'}
      jsonLd={jsonLd}
    />
    <slot name="head" />
  </head>
  <body>
    <!-- Skip to content link -->
    <a href="#content-start" class="skip-to-content">Skip to content</a>

    <!-- Unified Header -->
    <Header locale={locale} path={path} activeSection={section} />

    <div id="content-start">
      <slot />
    </div>

    <!-- Unified Footer -->
    <Footer locale={locale} path={path} />
  </body>
</html>

<style>
  .skip-to-content {
    position: absolute;
    top: -50px;
    left: var(--sp-4);
    background: var(--accent-brand);
    color: #ffffff;
    padding: 8px 16px;
    border-radius: var(--r-md);
    font-weight: 600;
    font-size: 13px;
    z-index: 999;
    transition: top var(--trans-fast);
  }
  .skip-to-content:focus {
    top: var(--sp-4);
  }
</style>
