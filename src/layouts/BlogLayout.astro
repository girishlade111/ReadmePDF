---
import '../styles/app.css';
import '../styles/blog.css';

const { title, description, article = false } = Astro.props;
const pageTitle = title.includes('ReadmePDF') ? title : `${title} — ReadmePDF`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23211e1c'/%3E%3Ctext x='16' y='23' font-size='17' text-anchor='middle' fill='white' font-family='sans-serif' font-weight='bold'%3ER%3C/text%3E%3C/svg%3E"
    />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f1efed" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content="ReadmePDF" />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
    <slot name="head" />
  </head>
  <body>
    <header class="masthead">
      <div class="container masthead__inner">
        <a class="wordmark" href="/">ReadmePDF</a>
        <span class="masthead__tag caption">by LadeStack · free · no login · client-side</span>
        <div class="masthead__utils">
          <a
            class="icon-link"
            href="https://github.com/girishlade111/ReadmePDF"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="ReadmePDF on GitHub"
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <nav class="subnav" aria-label="Section">
      <div class="container subnav__inner">
        <a href="/#converter">Converter</a>
        <a href="/#how">How it works</a>
        <a href="/#themes">Themes</a>
        <a href="/blog/" aria-current="page">Blog</a>
        <a href="/#privacy">Privacy</a>
      </div>
    </nav>

    <slot />

    <footer class="footer">
      <div class="container">
        <nav class="footer__links" aria-label="Footer">
          <a href="/#converter">Converter</a>
          <a href="/#how">How it works</a>
          <a href="/#themes">Themes</a>
          <a href="/blog/">Blog</a>
          <a href="/#privacy">Privacy</a>
          <a href="https://github.com/girishlade111/ReadmePDF" target="_blank" rel="noopener noreferrer">GitHub</a>
        </nav>
        <div class="footer__social">
          <a href="https://github.com/girishlade111/ReadmePDF" target="_blank" rel="noopener noreferrer" aria-label="ReadmePDF on GitHub">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
            </svg>
          </a>
          <a href="https://ladestack.in" target="_blank" rel="noopener noreferrer" aria-label="LadeStack">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M3.5 9.5 12 3.5l8.5 6v9a1.5 1.5 0 0 1-1.5 1.5h-14A1.5 1.5 0 0 1 3.5 18.5z" />
              <path d="M9.5 20v-6h5v6" />
            </svg>
          </a>
        </div>
        <p class="footer__credit caption">
          © 2026 LadeStack · ReadmePDF is free, MIT licensed, and built by Girish Lade.
        </p>
      </div>
    </footer>
  </body>
</html>
