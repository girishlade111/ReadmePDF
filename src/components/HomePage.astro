---
import '../styles/app.css';
import LanguageSwitcher from './LanguageSwitcher.astro';
import RichText from './RichText.astro';
import SeoHead from './SeoHead.astro';
import { localeHref, localeMeta } from '../i18n/config.js';
import { serializeDictionary, translator } from '../i18n/index.js';
import { homeJsonLd } from '../lib/seo.js';
import { siteFromEnv } from '../lib/site.js';

const { locale = 'en', path = '/' } = Astro.props;
const meta = localeMeta(locale);
const t = translator(locale);
const blogHref = localeHref(locale, '/blog/');
const aboutHref = localeHref(locale, '/about/');
const site = siteFromEnv(import.meta.env);
const jsonLd = homeJsonLd({
  locale,
  description: t('meta.home.description'),
  site,
  path,
});
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' fill='%23211e1c'/%3E%3Ctext x='16' y='23' font-size='17' text-anchor='middle' fill='white' font-family='sans-serif' font-weight='bold'%3EM%3C/text%3E%3C/svg%3E"
    />
    <meta name="theme-color" content="#f1efed" />
    <SeoHead
      title={t('meta.home.title')}
      description={t('meta.home.description')}
      locale={locale}
      path={path}
      type="website"
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <header class="masthead">
      <div class="container masthead__inner">
        <a class="wordmark" href="#top">md2pdf</a>
        <span class="masthead__tag caption">{t('home.tagline')}</span>
        <div class="masthead__utils">
          <LanguageSwitcher locale={locale} path={path} />
          <a
            class="icon-link"
            href="https://github.com/girishlade111/ReadmePDF"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('a11y.github')}
          >
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
              <path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22" />
            </svg>
          </a>
        </div>
      </div>
    </header>

    <nav class="subnav" aria-label={t('nav.sectionAria')}>
      <div class="container subnav__inner">
        <a href="#converter">{t('nav.converter')}</a>
        <a href="#book">{t('nav.book')}</a>
        <a href="#how">{t('nav.how')}</a>
        <a href="#themes">{t('nav.themes')}</a>
        <a href={blogHref}>{t('nav.blog')}</a>
        <a href={aboutHref}>{t('nav.about')}</a>
        <a href="#privacy">{t('nav.privacy')}</a>
      </div>
    </nav>

    <main id="top">
      <!-- ------------------------------------------------------------------ -->
      <section class="hero">
        <svg class="hero__pattern" viewBox="0 0 1440 520" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
          <g fill="none" stroke="currentColor" stroke-width="1">
            <path d="M-40 90 C 220 30 340 170 560 118 S 900 40 1480 120" />
            <path d="M-40 140 C 220 80 340 220 560 168 S 900 90 1480 170" />
            <path d="M-40 190 C 220 130 340 270 560 218 S 900 140 1480 220" />
            <path d="M-40 240 C 220 180 340 320 560 268 S 900 190 1480 270" />
            <path d="M-40 300 C 240 230 320 380 580 320 S 940 230 1480 330" />
            <path d="M-40 350 C 240 280 320 430 580 370 S 940 280 1480 380" />
            <path d="M-40 410 C 240 340 320 490 580 430 S 940 340 1480 440" />
            <path d="M-40 470 C 240 400 320 550 580 490 S 940 400 1480 500" />
          </g>
        </svg>
        <div class="container">
          <div class="hero__inner">
            <p class="hero__kicker">{t('home.hero.kicker')}</p>
            <h1 class="display-xl">
              {t('home.hero.titleLine1')}<br />{t('home.hero.titleLine2')}
            </h1>
            <span class="rule" aria-hidden="true"></span>
            <p class="lead">{t('home.hero.lead')}</p>
            <div class="btn-row">
              <a class="btn btn--primary" href="#converter">{t('home.hero.primary')}</a>
              <a class="btn btn--secondary" href="#how">{t('home.hero.secondary')}</a>
            </div>
          </div>
        </div>
      </section>

      <!-- ------------------------------------------------------------------ -->
      <section class="band band--white" id="converter">
        <div class="container">
          <div class="band__head">
            <h2 class="display-lg">{t('home.converter.title')}</h2>
            <p class="lead">{t('home.converter.lead')}</p>
          </div>

          <div class="tool">
            <section class="panel controls" aria-label={t('a11y.inputOptions')}>
              <h3 class="heading-md">{t('home.converter.step1')}</h3>
              <div class="row">
                <input
                  id="gh-url"
                  class="field field--search"
                  type="url"
                  inputmode="url"
                  aria-label={t('a11y.githubUrl')}
                  placeholder="https://github.com/owner/repo"
                  autocomplete="off"
                  spellcheck="false"
                />
                <button id="fetch-btn" class="btn btn--primary" type="button">{t('home.converter.fetch')}</button>
              </div>
              <p class="hint">{t('home.converter.hint')}</p>

              <h3 class="heading-md">{t('home.converter.step2')}</h3>
              <div class="row">
                <input
                  id="file-input"
                  class="field-file"
                  type="file"
                  accept=".md,.markdown,.mdown,.txt,text/markdown"
                  aria-label={t('a11y.uploadMarkdown')}
                />
              </div>
              <textarea
                id="md-input"
                class="field"
                aria-label={t('a11y.markdownInput')}
                placeholder={t('home.converter.placeholder')}
                spellcheck="false"></textarea>
              <div class="row" style="margin-top: var(--sp-sm)">
                <button id="sample-btn" class="btn btn--secondary" type="button">{t('home.converter.sample')}</button>
                <button id="clear-btn" class="btn btn--tertiary" type="button">{t('home.converter.clear')}</button>
              </div>

              <h3 class="heading-md">{t('home.converter.step3')}</h3>
              <div class="theme-grid" role="radiogroup" aria-label={t('a11y.pdfTheme')}>
                <label class="theme-tile"><input type="radio" name="theme" value="clean" checked />{t('theme.clean')}</label>
                <label class="theme-tile"><input type="radio" name="theme" value="business" />{t('theme.business')}</label>
                <label class="theme-tile"><input type="radio" name="theme" value="academic" />{t('theme.academic')}</label>
                <label class="theme-tile"><input type="radio" name="theme" value="dark" />{t('theme.dark')}</label>
              </div>
              <p class="warn" id="dark-warn" hidden>{t('home.converter.darkWarn')}</p>

              <h3 class="heading-md">{t('home.converter.step4')}</h3>
              <label class="check">
                <input id="toc-toggle" type="checkbox" checked />{t('home.converter.toc')}
              </label>

              <p class="status" id="status" role="status" aria-live="polite"></p>
              <p class="meta" id="meta"></p>
            </section>

            <section class="panel preview-wrap" aria-label={t('a11y.livePreview')}>
              <div class="preview-head">
                <span class="preview-head__title">{t('home.converter.previewTitle')}</span>
                <button id="print-btn" class="btn btn--primary" type="button">{t('home.converter.print')}</button>
              </div>
              <p class="hint no-print" style="margin-top: 0">{t('home.converter.printHint')}</p>
              <article id="sheet" class="sheet theme-clean">
                <div id="preview-doc" class="doc"></div>
              </article>
            </section>
          </div>
        </div>
      </section>

      <!-- ------------------------------------------------------------------ -->
      <section class="band band--white" id="book">
        <div class="container">
          <div class="band__head">
            <h2 class="display-lg">{t('home.book.title')}</h2>
            <p class="lead">{t('home.book.lead')}</p>
          </div>

          <div class="book-tool">
            <section class="panel book-controls" aria-label={t('a11y.bookSource')}>
              <h3 class="heading-md">{t('home.book.step1')}</h3>
              <div class="row">
                <input
                  id="book-url"
                  class="field"
                  type="url"
                  inputmode="url"
                  aria-label={t('a11y.bookUrl')}
                  placeholder="https://github.com/owner/repo"
                  autocomplete="off"
                  spellcheck="false"
                />
                <button id="book-scan-btn" class="btn btn--primary" type="button">{t('home.book.scan')}</button>
              </div>
              <div class="row book-row-actions">
                <button id="book-cancel-scan-btn" class="btn btn--tertiary" type="button" hidden>
                  {t('home.book.cancelScan')}
                </button>
              </div>
              <p class="hint"><RichText text={t('home.book.hint')} /></p>
              <p class="status" id="book-status" role="status" aria-live="polite"></p>
              <p class="meta" id="book-meta"></p>

              <div class="book-warnings" id="book-warnings" hidden>
                <p class="book-warnings__title">{t('home.book.listingNotice')}</p>
                <ul id="book-warning-list"></ul>
              </div>

              <div class="book-workspace" id="book-workspace">
                <div class="book-workspace__head">
                  <h3 class="heading-md">{t('home.book.step2')}</h3>
                  <span class="caption" id="book-file-summary">{t('home.book.noFiles')}</span>
                </div>
                <div class="row book-toolbar">
                  <button id="book-select-all" class="btn btn--tertiary" type="button">
                    {t('home.book.selectAll')}
                  </button>
                  <button id="book-clear-selection" class="btn btn--tertiary" type="button">
                    {t('home.book.clear')}
                  </button>
                </div>
                <input
                  id="book-search"
                  class="field book-search"
                  type="search"
                  aria-label={t('a11y.filterFiles')}
                  placeholder={t('home.book.filterPlaceholder')}
                  autocomplete="off"
                  spellcheck="false"
                />
                <div class="book-tree-wrap">
                  <div id="book-tree" class="book-tree"></div>
                  <p class="hint book-empty" id="book-tree-empty">{t('home.book.emptyTree')}</p>
                </div>
              </div>
            </section>

            <section class="panel book-builder" aria-label={t('a11y.bookOptions')}>
              <h3 class="heading-md">{t('home.book.step3')}</h3>
              <label class="book-field">
                <span class="label">{t('home.book.fieldTitle')}</span>
                <input
                  id="book-title"
                  class="field"
                  type="text"
                  placeholder={t('home.book.titlePlaceholder')}
                  autocomplete="off"
                />
              </label>
              <label class="book-field">
                <span class="label"
                  >{t('home.book.fieldSubtitle')}
                  <span class="book-optional">{t('home.book.optional')}</span></span
                >
                <input
                  id="book-subtitle"
                  class="field"
                  type="text"
                  placeholder={t('home.book.subtitlePlaceholder')}
                  autocomplete="off"
                />
              </label>
              <div class="book-checks">
                <label class="check">
                  <input id="book-cover-toggle" type="checkbox" checked />{t('home.book.cover')}
                </label>
                <label class="check">
                  <input id="book-toc-toggle" type="checkbox" checked />{t('home.book.masterToc')}
                </label>
              </div>

              <h3 class="heading-md">{t('home.book.step4')}</h3>
              <div class="theme-grid" role="radiogroup" aria-label={t('a11y.bookTheme')}>
                <label class="theme-tile"
                  ><input type="radio" name="book-theme" value="clean" checked />{t('theme.clean')}</label
                >
                <label class="theme-tile"
                  ><input type="radio" name="book-theme" value="business" />{t('theme.business')}</label
                >
                <label class="theme-tile"
                  ><input type="radio" name="book-theme" value="academic" />{t('theme.academic')}</label
                >
                <label class="theme-tile"
                  ><input type="radio" name="book-theme" value="dark" />{t('theme.dark')}</label
                >
              </div>

              <h3 class="heading-md">{t('home.book.step5')}</h3>
              <p class="hint book-chapters-hint">{t('home.book.chaptersHint')}</p>
              <ol class="book-chapters" id="book-chapters"></ol>
              <p class="hint book-empty" id="book-chapters-empty">{t('home.book.chaptersEmpty')}</p>

              <div class="row book-build-row">
                <button id="book-build-btn" class="btn btn--primary" type="button" disabled>
                  {t('home.book.build')}
                </button>
                <button id="book-build-cancel-btn" class="btn btn--tertiary" type="button" hidden>
                  {t('home.book.cancelBuild')}
                </button>
              </div>
              <p class="status" id="book-build-status" role="status" aria-live="polite"></p>

              <div class="book-failures" id="book-failures" hidden>
                <p class="book-failures__title">{t('home.book.failuresTitle')}</p>
                <ul id="book-failure-list"></ul>
                <div class="row">
                  <button id="book-retry-btn" class="btn btn--secondary" type="button" hidden>
                    {t('home.book.retry')}
                  </button>
                  <button id="book-drop-failures-btn" class="btn btn--tertiary" type="button" hidden>
                    {t('home.book.dropFailures')}
                  </button>
                </div>
              </div>

              <div class="book-export" id="book-export" aria-labelledby="book-export-title">
                <h3 class="heading-md" id="book-export-title">{t('home.book.exportTitle')}</h3>
                <p class="hint">{t('home.book.exportLead')}</p>
                <p class="hint book-export__limit">{t('home.book.exportLimit')}</p>
                <div class="row book-export__actions">
                  <button id="book-export-btn" class="btn btn--secondary" type="button" disabled>
                    {t('home.book.exportButton')}
                  </button>
                  <button id="book-export-cancel-btn" class="btn btn--tertiary" type="button" hidden>
                    {t('home.book.exportCancel')}
                  </button>
                  <a id="book-export-download" class="btn btn--primary" href="#" download hidden>
                    {t('home.book.exportDownload')}
                  </a>
                  <button id="book-export-retry-btn" class="btn btn--secondary" type="button" hidden>
                    {t('home.book.exportRetry')}
                  </button>
                  <button id="book-export-close-btn" class="btn btn--tertiary" type="button" hidden>
                    {t('home.book.exportClose')}
                  </button>
                </div>
                <div class="book-export__progress" id="book-export-progress-wrap" hidden>
                  <progress id="book-export-progress" max="100" value="0"></progress>
                  <span class="book-export__progress-label" id="book-export-progress-label"></span>
                </div>
                <p class="status" id="book-export-status" role="status" aria-live="polite"></p>
                <p class="hint book-export__warning" id="book-export-warning" hidden>
                  {t('home.book.exportWarning')}
                </p>
                <p class="hint" id="book-export-ready-hint" hidden>
                  {t('home.book.exportReadyHint')}
                </p>
                <div class="book-failures" id="book-export-failures" hidden>
                  <p class="book-failures__title">{t('home.book.exportFailuresTitle')}</p>
                  <ul id="book-export-failure-list"></ul>
                </div>
                <p class="hint book-export__single">{t('home.book.exportSingle')}</p>
              </div>
            </section>
          </div>

          <section class="panel book-preview-panel" aria-label={t('a11y.bookPreview')}>
            <div class="preview-head">
              <span class="preview-head__title">{t('home.book.previewTitle')}</span>
              <button id="book-print-btn" class="btn btn--primary" type="button" disabled>
                {t('home.book.print')}
              </button>
            </div>
            <p class="hint no-print" style="margin-top: 0">{t('home.book.printHint')}</p>
            <div class="book-preview-bar" id="book-preview-bar" hidden>
              <span class="book-preview-bar__label" id="book-preview-label"></span>
              <button id="book-preview-back" class="btn btn--tertiary" type="button">
                {t('home.book.back')}
              </button>
            </div>
            <article id="book-sheet" class="sheet book-sheet theme-clean">
              <div id="book-output" class="doc book-output"></div>
              <article id="book-preview" class="doc book-preview" hidden></article>
            </article>
          </section>
        </div>
      </section>

      <!-- ------------------------------------------------------------------ -->
      <section class="band band--teal">
        <div class="container">
          <p class="statement">
            <span class="statement__lead">{t('home.statement.lead')}</span>
            <span class="statement__body">{t('home.statement.body')}</span>
          </p>
        </div>
      </section>

      <!-- ------------------------------------------------------------------ -->
      <section class="band band--soft" id="how">
        <div class="container">
          <div class="band__head">
            <h2 class="display-lg">{t('home.how.title')}</h2>
            <p class="lead">{t('home.how.lead')}</p>
          </div>
          <div class="channels">
            <article class="channel">
              <span class="channel__icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4.5" y="7.5" width="23" height="18" rx="2" />
                  <path d="M4.5 12.5h23" />
                  <circle cx="9" cy="10" r="0.9" fill="currentColor" stroke="none" />
                  <path d="M13 18h11M13 21.5h7" />
                </svg>
              </span>
              <span class="channel__step">{t('home.how.stepLabel', { number: '01' })}</span>
              <h3 class="heading-lg">{t('home.how.step1.title')}</h3>
              <p class="body-loose"><RichText text={t('home.how.step1.body')} /></p>
              <a class="link-inline" href="#converter">{t('home.how.step1.link')}</a>
            </article>

            <article class="channel">
              <span class="channel__icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 6h14l6 6v14H6z" />
                  <path d="M20 6v6h6" />
                  <path d="M10.5 17.5h11M10.5 21.5h7" />
                </svg>
              </span>
              <span class="channel__step">{t('home.how.stepLabel', { number: '02' })}</span>
              <h3 class="heading-lg">{t('home.how.step2.title')}</h3>
              <p class="body-loose"><RichText text={t('home.how.step2.body')} /></p>
              <a class="link-inline" href="#themes">{t('home.how.step2.link')}</a>
            </article>

            <article class="channel">
              <span class="channel__icon" aria-hidden="true">
                <svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M9 9.5V4.5h14v5" />
                  <rect x="4.5" y="9.5" width="23" height="10" rx="2" />
                  <path d="M9 19.5h14v8H9z" />
                  <path d="M22.5 14h1" />
                </svg>
              </span>
              <span class="channel__step">{t('home.how.stepLabel', { number: '03' })}</span>
              <h3 class="heading-lg">{t('home.how.step3.title')}</h3>
              <p class="body-loose"><RichText text={t('home.how.step3.body')} /></p>
              <a class="link-inline" href="#privacy">{t('home.how.step3.link')}</a>
            </article>
          </div>
        </div>
      </section>

      <!-- ------------------------------------------------------------------ -->
      <section class="band band--tint" id="themes">
        <div class="container">
          <div class="band__head">
            <h2 class="display-lg">{t('home.themes.title')}</h2>
            <p class="lead">{t('home.themes.lead')}</p>
          </div>
          <div class="theme-cards">
            <article class="theme-card">
              <h3 class="heading-sm">{t('theme.clean')}</h3>
              <p class="body-loose">{t('home.themes.clean')}</p>
              <div class="swatch swatch--clean" aria-hidden="true">
                <div class="swatch__title">README</div>
                <div class="swatch__line"></div>
                <div class="swatch__line swatch__line--short"></div>
                <div class="swatch__code"></div>
              </div>
            </article>
            <article class="theme-card">
              <h3 class="heading-sm">{t('theme.business')}</h3>
              <p class="body-loose">{t('home.themes.business')}</p>
              <div class="swatch swatch--business" aria-hidden="true">
                <div class="swatch__title">README</div>
                <div class="swatch__line"></div>
                <div class="swatch__line swatch__line--short"></div>
                <div class="swatch__code"></div>
              </div>
            </article>
            <article class="theme-card">
              <h3 class="heading-sm">{t('theme.academic')}</h3>
              <p class="body-loose">{t('home.themes.academic')}</p>
              <div class="swatch swatch--academic" aria-hidden="true">
                <div class="swatch__title">README</div>
                <div class="swatch__line"></div>
                <div class="swatch__line swatch__line--short"></div>
                <div class="swatch__code"></div>
              </div>
            </article>
            <article class="theme-card">
              <h3 class="heading-sm">{t('theme.dark')}</h3>
              <p class="body-loose">{t('home.themes.dark')}</p>
              <div class="swatch swatch--dark" aria-hidden="true">
                <div class="swatch__title">README</div>
                <div class="swatch__line"></div>
                <div class="swatch__line swatch__line--short"></div>
                <div class="swatch__code"></div>
              </div>
            </article>
          </div>
        </div>
      </section>

      <!-- ------------------------------------------------------------------ -->
      <section class="band band--warm">
        <div class="container">
          <div class="band__head">
            <h2 class="display-lg">{t('home.features.title')}</h2>
            <p class="lead">{t('home.features.lead')}</p>
          </div>
          <div class="feature-grid">
            <article class="feature">
              <h3 class="heading-lg">{t('home.features.fetching')}</h3>
              <ul>
                <li>
                  <strong>{t('home.features.fetch1.title')}</strong>
                  <RichText text={t('home.features.fetch1.body')} />
                </li>
                <li>
                  <strong>{t('home.features.fetch2.title')}</strong>
                  <RichText text={t('home.features.fetch2.body')} />
                </li>
                <li>
                  <strong>{t('home.features.fetch3.title')}</strong>
                  <RichText text={t('home.features.fetch3.body')} />
                </li>
                <li>
                  <strong>{t('home.features.fetch4.title')}</strong>
                  <RichText text={t('home.features.fetch4.body')} />
                </li>
              </ul>
