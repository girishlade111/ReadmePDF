---
import '../styles/app.css';
import Header from './sections/Header.astro';
import Hero from './sections/Hero.astro';
import FeaturesBento from './sections/FeaturesBento.astro';
import HowItWorks from './sections/HowItWorks.astro';
import UseCases from './sections/UseCases.astro';
import ThemesSection from './sections/ThemesSection.astro';
import FaqSection from './sections/FaqSection.astro';
import HumanSitemapSection from './sections/HumanSitemapSection.astro';
import Footer from './sections/Footer.astro';
import HistoryDrawer from './HistoryDrawer.astro';
import RichText from './RichText.astro';
import SeoHead from './SeoHead.astro';
import Icon from './ui/Icon.astro';
import Badge from './ui/Badge.astro';
import { localeHref, localeMeta } from '../i18n/config.js';
import { serializeDictionary, translator } from '../i18n/index.js';
import { homeJsonLd } from '../lib/seo.js';
import { siteFromEnv } from '../lib/site.js';

const { locale = 'en', path = '/' } = Astro.props;
const meta = localeMeta(locale);
const t = translator(locale);
const blogHref = localeHref(locale, '/blog/');
const aboutHref = localeHref(locale, '/about/');
const site = siteFromEnv(import.meta.env);
const jsonLd = homeJsonLd({
  locale,
  description: t('meta.home.description'),
  site,
  path,
});
---

<!doctype html>
<html lang={meta.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link
      rel="icon"
      href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Crect width='32' height='32' rx='6' fill='%2310b981'/%3E%3Ctext x='16' y='22' font-size='16' text-anchor='middle' fill='white' font-family='sans-serif' font-weight='800'%3EM%3C/text%3E%3C/svg%3E"
    />
    <meta name="theme-color" content="#07080b" />
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('md2pdf-theme');
        const isDark = stored === 'dark' || (!stored && window.matchMedia('(prefers-color-scheme: dark)').matches);
        if (isDark) document.documentElement.dataset.theme = 'dark';
      })();
    </script>
    <SeoHead
      title={t('meta.home.title')}
      description={t('meta.home.description')}
      locale={locale}
      path={path}
      type="website"
      jsonLd={jsonLd}
    />
  </head>
  <body>
    <!-- Skip to content link for accessibility -->
    <a href="#converter" class="skip-to-content">Skip to converter</a>

    <!-- Unified Site Header -->
    <Header locale={locale} path={path} />

    <main id="top">
      <!-- 1. Hero Section with Dual-Pane Mockup -->
      <Hero locale={locale} />

      <!-- 2. Interactive Single Document Converter -->
      <section class="band band--white converter-section" id="converter">
        <div class="container">
          <div class="band__head section-head">
            <Badge variant="brand" size="md">Single Document Engine</Badge>
            <h2 class="display-lg section-title">{t('home.converter.title')}</h2>
            <p class="lead section-lead">{t('home.converter.lead')}</p>
          </div>

          <div class="tool tool-workspace">
            <!-- Left: Controls Panel -->
            <section class="panel controls tool-controls" aria-label={t('a11y.inputOptions')}>
              <!-- Step 1: GitHub URL -->
              <div class="control-group">
                <div class="control-group__header">
                  <span class="step-badge">1</span>
                  <h3 class="heading-md">{t('home.converter.step1')}</h3>
                </div>
                <div class="row">
                  <input
                    id="gh-url"
                    class="field field--search"
                    type="url"
                    inputmode="url"
                    aria-label={t('a11y.githubUrl')}
                    placeholder="https://github.com/owner/repo"
                    autocomplete="off"
                    spellcheck="false"
                  />
                  <button id="fetch-btn" class="btn btn--primary" type="button">
                    <Icon name="download" size={16} />
                    <span>{t('home.converter.fetch')}</span>
                  </button>
                </div>
                <p class="hint">{t('home.converter.hint')}</p>
              </div>

              <!-- Step 2: Markdown Input / Upload -->
              <div class="control-group">
                <div class="control-group__header" style="justify-content: space-between;">
                  <div style="display: flex; align-items: center; gap: var(--sp-2);">
                    <span class="step-badge">2</span>
                    <h3 class="heading-md">{t('home.converter.step2')}</h3>
                  </div>
                  <div id="autosave-indicator" class="autosave-indicator" title={t('history.autoSave')} aria-live="polite">
                    <span id="autosave-dot" class="autosave-dot"></span>
                    <span id="autosave-status" class="autosave-status">{t('history.autoSaveOff')}</span>
                  </div>
                </div>
                <div class="row file-upload-row">
                  <input
                    id="file-input"
                    class="field-file"
                    type="file"
                    accept=".md,.markdown,.mdown,.txt,text/markdown"
                    aria-label={t('a11y.uploadMarkdown')}
                  />
                </div>
                <textarea
                  id="md-input"
                  class="field md-textarea"
                  aria-label={t('a11y.markdownInput')}
                  placeholder={t('home.converter.placeholder')}
                  spellcheck="false"
                ></textarea>
                <div class="row tool-actions-row">
                  <button id="sample-btn" class="btn btn--secondary" type="button">
                    <Icon name="file-text" size={15} />
                    <span>{t('home.converter.sample')}</span>
                  </button>
                  <button id="clear-btn" class="btn btn--tertiary" type="button">
                    <Icon name="x" size={15} />
                    <span>{t('home.converter.clear')}</span>
                  </button>
                  <button id="save-version-btn" class="btn btn--secondary" type="button" title={t('history.saveVersion')}>
                    <Icon name="bookmark" size={15} />
                    <span>{t('history.saveVersion')}</span>
                  </button>
                  <button id="open-history-btn" class="btn btn--secondary" type="button" data-open-history title={t('history.title')}>
                    <Icon name="clock" size={15} />
                    <span>{t('history.title')}</span>
                  </button>
                </div>
              </div>

              <!-- Step 3: Print Theme -->
              <div class="control-group">
                <div class="control-group__header">
                  <span class="step-badge">3</span>
                  <h3 class="heading-md">{t('home.converter.step3')}</h3>
                </div>
                <div class="theme-grid" role="radiogroup" aria-label={t('a11y.pdfTheme')}>
                  <label class="theme-tile">
                    <input type="radio" name="theme" value="clean" checked />
                    <span>{t('theme.clean')}</span>
                  </label>
                  <label class="theme-tile">
                    <input type="radio" name="theme" value="business" />
                    <span>{t('theme.business')}</span>
                  </label>
                  <label class="theme-tile">
                    <input type="radio" name="theme" value="academic" />
                    <span>{t('theme.academic')}</span>
                  </label>
                  <label class="theme-tile">
                    <input type="radio" name="theme" value="dark" />
                    <span>{t('theme.dark')}</span>
                  </label>
                </div>
                <p class="warn" id="dark-warn" hidden>{t('home.converter.darkWarn')}</p>
              </div>

              <!-- Step 4: Table of Contents -->
              <div class="control-group">
                <div class="control-group__header">
                  <span class="step-badge">4</span>
                  <h3 class="heading-md">{t('home.converter.step4')}</h3>
                </div>
                <label class="check custom-check">
                  <input id="toc-toggle" type="checkbox" checked />
                  <span class="check-box"></span>
                  <span class="check-label">{t('home.converter.toc')}</span>
                </label>
              </div>

              <div class="tool-feedback">
                <p class="status" id="status" role="status" aria-live="polite"></p>
                <p class="meta" id="meta"></p>
              </div>
            </section>

            <!-- Right: Live Preview Panel -->
            <section class="panel preview-wrap tool-preview" aria-label={t('a11y.livePreview')}>
              <div class="preview-head">
                <div class="preview-head__info">
                  <span class="preview-head__indicator" aria-hidden="true"></span>
                  <span class="preview-head__title">{t('home.converter.previewTitle')}</span>
                </div>
                <button id="print-btn" class="btn btn--primary btn--print" type="button">
                  <Icon name="printer" size={17} />
                  <span>{t('home.converter.print')}</span>
                </button>
              </div>
              <p class="hint no-print print-hint">{t('home.converter.printHint')}</p>
              <article id="sheet" class="sheet theme-clean">
                <div id="preview-doc" class="doc"></div>
              </article>
            </section>
          </div>
        </div>
      </section>

      <!-- 3. Multi-Chapter Documentation Book Builder -->
      <section class="band band--white" id="book">
        <div class="container">
          <div class="band__head section-head">
            <Badge variant="brand" size="md">Multi-Chapter Engine</Badge>
            <h2 class="display-lg section-title">{t('home.book.title')}</h2>
            <p class="lead section-lead">{t('home.book.lead')}</p>
          </div>

          <div class="book-tool book-workspace-grid">
            <!-- Left: Book Source & File Selection -->
            <section class="panel book-controls" aria-label={t('a11y.bookSource')}>
              <div class="control-group">
                <div class="control-group__header">
                  <span class="step-badge">1</span>
                  <h3 class="heading-md">{t('home.book.step1')}</h3>
                </div>
                <div class="row">
                  <input
                    id="book-url"
                    class="field"
                    type="url"
                    inputmode="url"
                    aria-label={t('a11y.bookUrl')}
                    placeholder="https://github.com/owner/repo"
                    autocomplete="off"
                    spellcheck="false"
                  />
                  <button id="book-scan-btn" class="btn btn--primary" type="button">
                    <Icon name="search" size={16} />
                    <span>{t('home.book.scan')}</span>
                  </button>
                </div>
                <div class="row book-row-actions">
                  <button id="book-cancel-scan-btn" class="btn btn--tertiary" type="button" hidden>
                    {t('home.book.cancelScan')}
                  </button>
                </div>
                <p class="hint"><RichText text={t('home.book.hint')} /></p>
                <p class="status" id="book-status" role="status" aria-live="polite"></p>
                <p class="meta" id="book-meta"></p>
              </div>

              <div class="book-warnings" id="book-warnings" hidden>
                <p class="book-warnings__title">{t('home.book.listingNotice')}</p>
                <ul id="book-warning-list"></ul>
              </div>

              <!-- Workspace: Search & File Tree -->
              <div class="book-workspace" id="book-workspace">
                <div class="book-workspace__head">
                  <div class="control-group__header">
                    <span class="step-badge">2</span>
                    <h3 class="heading-md">{t('home.book.step2')}</h3>
                  </div>
                  <span class="caption book-file-summary" id="book-file-summary">{t('home.book.noFiles')}</span>
                </div>
                <div class="row book-toolbar">
                  <button id="book-select-all" class="btn btn--tertiary btn--xs" type="button">
                    {t('home.book.selectAll')}
                  </button>
                  <button id="book-clear-selection" class="btn btn--tertiary btn--xs" type="button">
                    {t('home.book.clear')}
                  </button>
                </div>
                <input
                  id="book-search"
                  class="field book-search"
                  type="search"
                  aria-label={t('a11y.filterFiles')}
                  placeholder={t('home.book.filterPlaceholder')}
                  autocomplete="off"
                  spellcheck="false"
                />
                <div class="book-tree-wrap">
                  <div id="book-tree" class="book-tree"></div>
                  <p class="hint book-empty" id="book-tree-empty">{t('home.book.emptyTree')}</p>
                </div>
              </div>
            </section>

            <!-- Right: Book Builder Options & Chapter Sequencing -->
            <section class="panel book-builder" aria-label={t('a11y.bookOptions')}>
              <div class="control-group">
                <div class="control-group__header">
                  <span class="step-badge">3</span>
                  <h3 class="heading-md">{t('home.book.step3')}</h3>
                </div>
                <label class="book-field">
                  <span class="label">{t('home.book.fieldTitle')}</span>
                  <input
                    id="book-title"
                    class="field"
                    type="text"
                    placeholder={t('home.book.titlePlaceholder')}
                    autocomplete="off"
                  />
                </label>
                <label class="book-field" style="margin-top: 8px;">
                  <span class="label">
                    {t('home.book.fieldSubtitle')}
                    <span class="book-optional">({t('home.book.optional')})</span>
                  </span>
                  <input
                    id="book-subtitle"
                    class="field"
                    type="text"
                    placeholder={t('home.book.subtitlePlaceholder')}
                    autocomplete="off"
                  />
                </label>
                <div class="book-checks">
                  <label class="check custom-check">
                    <input id="book-cover-toggle" type="checkbox" checked />
                    <span class="check-box"></span>
                    <span class="check-label">{t('home.book.cover')}</span>
                  </label>
                  <label class="check custom-check">
                    <input id="book-toc-toggle" type="checkbox" checked />
                    <span class="check-box"></span>
                    <span class="check-label">{t('home.book.masterToc')}</span>
                  </label>
                </div>
              </div>

              <div class="control-group">
                <div class="control-group__header">
                  <span class="step-badge">4</span>
                  <h3 class="heading-md">{t('home.book.step4')}</h3>
                </div>
                <div class="theme-grid" role="radiogroup" aria-label={t('a11y.bookTheme')}>
                  <label class="theme-tile">
                    <input type="radio" name="book-theme" value="clean" checked />
                    <span>{t('theme.clean')}</span>
                  </label>
                  <label class="theme-tile">
                    <input type="radio" name="book-theme" value="business" />
                    <span>{t('theme.business')}</span>
                  </label>
                  <label class="theme-tile">
                    <input type="radio" name="book-theme" value="academic" />
                    <span>{t('theme.academic')}</span>
                  </label>
                  <label class="theme-tile">
                    <input type="radio" name="book-theme" value="dark" />
                    <span>{t('theme.dark')}</span>
                  </label>
                </div>
              </div>

              <!-- Step 5: Chapter Sequence -->
              <div class="control-group">
                <div class="control-group__header">
                  <span class="step-badge">5</span>
                  <h3 class="heading-md">{t('home.book.step5')}</h3>
                </div>
                <p class="hint book-chapters-hint">{t('home.book.chaptersHint')}</p>
                <ol class="book-chapters" id="book-chapters"></ol>
                <p class="hint book-empty" id="book-chapters-empty">{t('home.book.chaptersEmpty')}</p>

                <div class="row book-build-row">
                  <button id="book-build-btn" class="btn btn--primary" type="button" disabled>
                    <Icon name="layers" size={16} />
                    <span>{t('home.book.build')}</span>
                  </button>
                  <button id="book-save-snapshot-btn" class="btn btn--secondary" type="button" title={t('history.saveBookSnapshot')}>
                    <Icon name="bookmark" size={16} />
                    <span>{t('history.saveBookSnapshot')}</span>
                  </button>
                  <button id="book-history-btn" class="btn btn--secondary" type="button" data-open-history title={t('history.title')}>
                    <Icon name="clock" size={16} />
                    <span>{t('history.title')}</span>
                  </button>
                  <button id="book-build-cancel-btn" class="btn btn--tertiary" type="button" hidden>
                    {t('home.book.cancelBuild')}
                  </button>
                </div>
                <p class="status" id="book-build-status" role="status" aria-live="polite"></p>

                <div class="book-failures" id="book-failures" hidden>
                  <p class="book-failures__title">{t('home.book.failuresTitle')}</p>
                  <ul id="book-failure-list"></ul>
                  <div class="row">
                    <button id="book-retry-btn" class="btn btn--secondary" type="button" hidden>
                      {t('home.book.retry')}
                    </button>
                    <button id="book-drop-failures-btn" class="btn btn--tertiary" type="button" hidden>
                      {t('home.book.dropFailures')}
                    </button>
                  </div>
                </div>
              </div>

              <!-- Export Box -->
              <div class="book-export" id="book-export" aria-labelledby="book-export-title">
                <h3 class="heading-md" id="book-export-title">{t('home.book.exportTitle')}</h3>
                <p class="hint">{t('home.book.exportLead')}</p>
                <p class="hint book-export__limit">{t('home.book.exportLimit')}</p>
                <div class="row book-export__actions">
                  <button id="book-export-btn" class="btn btn--secondary" type="button" disabled>
                    <Icon name="download" size={15} />
                    <span>{t('home.book.exportButton')}</span>
                  </button>
                  <button id="book-export-cancel-btn" class="btn btn--tertiary" type="button" hidden>
                    {t('home.book.exportCancel')}
                  </button>
                  <a id="book-export-download" class="btn btn--primary" href="#" download hidden>
                    <Icon name="download" size={15} />
                    <span>{t('home.book.exportDownload')}</span>
                  </a>
                  <button id="book-export-retry-btn" class="btn btn--secondary" type="button" hidden>
                    {t('home.book.exportRetry')}
                  </button>
                  <button id="book-export-close-btn" class="btn btn--tertiary" type="button" hidden>
                    {t('home.book.exportClose')}
                  </button>
                </div>
                <div class="book-export__progress" id="book-export-progress-wrap" hidden>
                  <progress id="book-export-progress" max="100" value="0"></progress>
                  <span class="book-export__progress-label" id="book-export-progress-label"></span>
                </div>
                <p class="status" id="book-export-status" role="status" aria-live="polite"></p>
                <p class="hint book-export__warning" id="book-export-warning" hidden>
                  {t('home.book.exportWarning')}
                </p>
                <p class="hint" id="book-export-ready-hint" hidden>
                  {t('home.book.exportReadyHint')}
                </p>
                <div class="book-failures" id="book-export-failures" hidden>
                  <p class="book-failures__title">{t('home.book.exportFailuresTitle')}</p>
                  <ul id="book-export-failure-list"></ul>
                </div>
                <p class="hint book-export__single">{t('home.book.exportSingle')}</p>
              </div>
            </section>
          </div>

          <!-- Book Preview Sheet -->
          <section class="panel book-preview-panel" aria-label={t('a11y.bookPreview')}>
            <div class="preview-head">
              <div class="preview-head__info">
                <span class="preview-head__indicator" aria-hidden="true"></span>
                <span class="preview-head__title">{t('home.book.previewTitle')}</span>
              </div>
              <button id="book-print-btn" class="btn btn--primary btn--print" type="button" disabled>
                <Icon name="printer" size={17} />
                <span>{t('home.book.print')}</span>
              </button>
            </div>
            <p class="hint no-print print-hint">{t('home.book.printHint')}</p>
            <div class="book-preview-bar" id="book-preview-bar" hidden>
              <span class="book-preview-bar__label" id="book-preview-label"></span>
              <button id="book-preview-back" class="btn btn--tertiary" type="button">
                {t('home.book.back')}
              </button>
            </div>
            <article id="book-sheet" class="sheet book-sheet theme-clean">
              <div id="book-output" class="doc book-output"></div>
              <article id="book-preview" class="doc book-preview" hidden></article>
            </article>
          </section>
        </div>
      </section>

      <!-- 4. Features Bento Grid Section -->
      <FeaturesBento locale={locale} />

      <!-- 5. How It Works Pipeline -->
      <HowItWorks locale={locale} />

      <!-- 6. Real-World Use Cases -->
      <UseCases locale={locale} />

      <!-- 7. Print Themes Showcase -->
      <ThemesSection locale={locale} />

      <!-- 8. Frequently Asked Questions -->
      <FaqSection locale={locale} />

      <!-- 9. Human-Readable Sitemap -->
      <HumanSitemapSection locale={locale} />
    </main>

    <!-- Unified Site Footer -->
    <Footer locale={locale} path={path} />

    <!-- History & Storage Management Drawer -->
    <HistoryDrawer locale={locale} />

    <!-- Client-side controllers and dictionaries -->
    <script type="application/json" id="md2pdf-i18n" set:html={serializeDictionary(locale)} />
    <script>
      import { initConverter } from '../scripts/converter.js';
      import { initBookExplorer } from '../scripts/book-explorer.js';
      import { initHistoryUi } from '../scripts/history-ui.js';
      const conv = initConverter();
      const book = initBookExplorer();
      initHistoryUi({
        onRestoreConverter: conv?.restoreConverterEntry,
        hasUnsavedConverterWork: conv?.hasUnsavedWork,
        onRestoreBook: book?.restoreBookSnapshot,
        onAutoSaveToggle: (enabled) => conv?.autoSave?.setEnabled(enabled),
        onClearAll: () => conv?.autoSave?.cancelPending(),
      });
    </script>
  </body>
</html>

<style>
  /* Accessibility skip link */
  .skip-to-content {
    position: absolute;
    top: -50px;
    left: var(--sp-4);
    background: var(--accent-brand);
    color: #ffffff;
    padding: 8px 16px;
    border-radius: var(--r-md);
    font-weight: 600;
    font-size: 13px;
    z-index: 999;
    transition: top var(--trans-fast);
  }
  .skip-to-content:focus {
    top: var(--sp-4);
  }

  /* Section headers */
  .section-head {
    max-width: 680px;
    margin: 0 auto var(--sp-12);
    text-align: center;
  }

  .section-title {
    font-size: clamp(28px, 4vw, 42px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: var(--sp-3) 0 var(--sp-4);
  }

  .section-lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  /* Control Groups */
  .control-group {
    margin-bottom: var(--sp-6);
  }

  .control-group__header {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-3);
  }

  .step-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: var(--r-full);
    background: var(--accent-brand-subtle);
    color: var(--accent-brand-text);
    font-size: 11px;
    font-weight: 700;
    font-family: var(--font-mono);
  }

  .control-group__header h3 {
    font-size: 14px;
    font-weight: 600;
    color: var(--text-primary);
    margin: 0;
  }

  /* Inputs & Checkboxes */
  .custom-check {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font-size: 14px;
    color: var(--text-secondary);
    user-select: none;
  }

  .custom-check input {
    accent-color: var(--accent-brand);
    width: 16px;
    height: 16px;
  }

  /* Preview Header */
  .preview-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: var(--sp-4);
    border-bottom: 1px solid var(--border-subtle);
    margin-bottom: var(--sp-3);
  }

  .preview-head__info {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .preview-head__indicator {
    width: 8px;
    height: 8px;
    border-radius: var(--r-full);
    background: var(--accent-brand);
    box-shadow: 0 0 8px var(--accent-brand);
  }

  .preview-head__title {
    font-size: 14px;
    font-weight: 600;
