---
import { translator } from '../i18n/index.js';
import { formatDate, isoDate, postHref, readingTime, tagLabel } from '../lib/blog.js';

const { post, locale = 'en', headingLevel = 'h3' } = Astro.props;
const t = translator(locale);
const Heading = headingLevel;
const href = postHref(post, locale);
---

<article class="blog-card">
  <div class="blog-tags" aria-label={t('a11y.tags')}>
    {post.data.tags.map((tag) => <span class="blog-tag">{tagLabel(tag, t)}</span>)}
  </div>
  <Heading class="blog-card__title">
    <a href={href}>{post.data.title}</a>
  </Heading>
  <p class="blog-card__desc">{post.data.description}</p>
  <div class="blog-card__footer">
    <div class="blog-meta">
      <time datetime={isoDate(post.data.pubDate)}>{formatDate(post.data.pubDate, locale)}</time>
      <span aria-hidden="true">·</span>
      <span>{t('blog.readingTime', { minutes: readingTime(post.body, locale) })}</span>
    </div>
    <a class="blog-card__read" href={href}>
      {t('blog.readGuide')} <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
