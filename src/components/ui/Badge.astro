---
interface Props {
  variant?: 'default' | 'brand' | 'outline' | 'subtle';
  size?: 'sm' | 'md';
  class?: string;
}

const {
  variant = 'default',
  size = 'md',
  class: className = '',
} = Astro.props;

const classes = [
  'ui-badge',
  `ui-badge--${variant}`,
  `ui-badge--${size}`,
  className,
].filter(Boolean).join(' ');
---

<span class={classes}>
  <slot />
</span>

<style>
  .ui-badge {
    display: inline-flex;
    align-items: center;
    gap: var(--sp-1);
    font-family: var(--font-sans);
    font-weight: 500;
    line-height: 1;
    border-radius: var(--r-full);
    white-space: nowrap;
    border: 1px solid transparent;
  }

  .ui-badge--sm {
    padding: 3px 8px;
    font-size: 11px;
    letter-spacing: 0.02em;
  }

  .ui-badge--md {
    padding: 4px 11px;
    font-size: 12px;
  }

  .ui-badge--default {
    background: var(--bg-elevated);
    color: var(--text-secondary);
    border-color: var(--border-subtle);
  }

  .ui-badge--brand {
    background: var(--accent-brand-subtle);
    color: var(--accent-brand-text);
    border-color: var(--accent-brand-glow);
  }

  .ui-badge--outline {
    background: transparent;
    color: var(--text-secondary);
    border-color: var(--border-subtle);
  }

  .ui-badge--subtle {
    background: var(--bg-subtle);
    color: var(--text-muted);
  }
</style>
