---
import Icon from '../ui/Icon.astro';
import ThemeToggle from '../ui/ThemeToggle.astro';
import LanguageSwitcher from '../LanguageSwitcher.astro';
import { localeHref } from '../../i18n/config.js';
import { translator } from '../../i18n/index.js';

interface Props {
  locale?: string;
  path?: string;
}

const { locale = 'en', path = '/' } = Astro.props;
const t = translator(locale);

const homeHref = localeHref(locale, '/');
const blogHref = localeHref(locale, '/blog/');
const aboutHref = localeHref(locale, '/about/');

const isHomePage = path === '/' || path === `/${locale}/` || path === `/${locale}`;
---

<footer class="site-footer footer" id="site-footer">
  <div class="site-footer__container">
    <div class="site-footer__grid">
      <!-- Col 1: Brand & Statement -->
      <div class="site-footer__brand-col">
        <a class="site-footer__brand" href={homeHref}>
          <span class="site-footer__dot" aria-hidden="true"></span>
          <span>md2pdf</span>
        </a>
        <p class="site-footer__desc">
          Free, no-login, 100% in-browser GitHub README to PDF converter and documentation book assembler. Part of <a href="https://ladestack.in" target="_blank" rel="noopener noreferrer">LadeStack</a>.
        </p>
        <div class="site-footer__guarantee">
          <Icon name="shield" size={15} />
          <span>Zero Server Uploads · 100% Client-Side Memory</span>
        </div>
      </div>

      <!-- Col 2: Product Navigation -->
      <div class="site-footer__nav-col">
        <h4 class="site-footer__heading">Product</h4>
        <ul class="site-footer__list footer__links">
          <li><a href={isHomePage ? '#converter' : `${homeHref}#converter`}>{t('nav.converter')}</a></li>
          <li><a href={isHomePage ? '#book' : `${homeHref}#book`}>{t('nav.book')}</a></li>
          <li><a href={isHomePage ? '#features' : `${homeHref}#features`}>Features</a></li>
          <li><a href={isHomePage ? '#how' : `${homeHref}#how`}>{t('nav.how')}</a></li>
          <li><a href={isHomePage ? '#use-cases' : `${homeHref}#use-cases`}>Use Cases</a></li>
          <li><a href={isHomePage ? '#themes' : `${homeHref}#themes`}>{t('nav.themes')}</a></li>
          <li><a href={isHomePage ? '#faq' : `${homeHref}#faq`}>FAQ</a></li>
        </ul>
      </div>

      <!-- Col 3: Resources & Guides -->
      <div class="site-footer__nav-col">
        <h4 class="site-footer__heading">Resources</h4>
        <ul class="site-footer__list">
          <li><a href={blogHref}>{t('nav.blog')}</a></li>
          <li><a href={aboutHref}>{t('nav.about')}</a></li>
          <li><a href={isHomePage ? '#sitemap' : `${homeHref}#sitemap`}>Sitemap</a></li>
          <li><a href="https://github.com/girishlade111/ReadmePDF/blob/main/README.md" target="_blank" rel="noopener noreferrer">Documentation</a></li>
          <li><a href="https://github.com/girishlade111/ReadmePDF/issues" target="_blank" rel="noopener noreferrer">Report Issue</a></li>
        </ul>
      </div>

      <!-- Col 4: Community & Settings -->
      <div class="site-footer__nav-col">
        <h4 class="site-footer__heading">Connect & Settings</h4>
        <div class="site-footer__social footer__social">
          <a
            href="https://github.com/girishlade111/ReadmePDF"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('a11y.github')}
            title="GitHub"
          >
            <Icon name="github" size={18} />
          </a>
          <a
            href="https://www.linkedin.com/in/girish-lade/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('a11y.linkedin')}
            title="LinkedIn"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z" />
              <rect x="2" y="9" width="4" height="12" />
              <circle cx="4" cy="4" r="2" />
            </svg>
          </a>
          <a
            href="https://ladestack.in"
            target="_blank"
            rel="noopener noreferrer"
            aria-label={t('a11y.ladestack')}
            title="LadeStack"
          >
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z" />
              <polyline points="9 22 9 12 15 12 15 22" />
            </svg>
          </a>
        </div>
        <div class="site-footer__controls">
          <LanguageSwitcher locale={locale} path={path} />
          <ThemeToggle />
        </div>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="site-footer__bottom">
      <p class="site-footer__credit footer__credit caption">
        {t('footer.credit')}
      </p>
      <div class="site-footer__meta">
        <a href="#top" class="site-footer__back-top">
          <span>Back to top</span>
          <Icon name="chevron-up" size={14} />
        </a>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
    padding: var(--sp-16) 0 var(--sp-8);
    color: var(--text-secondary);
    transition: background var(--trans-fast), border-color var(--trans-fast);
  }

  .site-footer__container {
    max-width: var(--container-max);
    margin: 0 auto;
    padding: 0 var(--container-gutter);
  }

  .site-footer__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) repeat(3, minmax(0, 1fr));
    gap: var(--sp-10);
    padding-bottom: var(--sp-12);
    border-bottom: 1px solid var(--border-subtle);
  }

  .site-footer__brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 18px;
    font-weight: 700;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.02em;
    margin-bottom: var(--sp-3);
  }

  .site-footer__dot {
    width: 8px;
    height: 8px;
    border-radius: var(--r-full);
    background: var(--accent-brand);
  }

  .site-footer__desc {
    font-size: 13px;
    line-height: 1.6;
    color: var(--text-muted);
    max-width: 320px;
    margin: 0 0 var(--sp-4);
  }

  .site-footer__desc a {
    color: var(--text-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .site-footer__guarantee {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    font-weight: 500;
    color: var(--accent-brand-text);
    background: var(--accent-brand-subtle);
    padding: 5px 10px;
    border-radius: var(--r-full);
    border: 1px solid var(--accent-brand-glow);
  }

  .site-footer__heading {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-primary);
    margin: 0 0 var(--sp-4);
  }

  .site-footer__list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sp-2);
  }

  .site-footer__list a {
    font-size: 14px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--trans-fast);
  }

  .site-footer__list a:hover {
    color: var(--accent-brand);
  }

  .site-footer__social {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    margin-bottom: var(--sp-4);
  }

  .site-footer__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: var(--r-md);
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    color: var(--text-secondary);
    transition: all var(--trans-fast);
    text-decoration: none;
  }

  .site-footer__social a:hover {
    background: var(--bg-surface);
    color: var(--text-primary);
    border-color: var(--border-medium);
    transform: translateY(-1px);
  }

  .site-footer__controls {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
  }

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: var(--sp-4);
    padding-top: var(--sp-6);
  }

  .site-footer__credit {
    font-size: 13px;
    color: var(--text-muted);
    margin: 0;
  }

  .site-footer__back-top {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color var(--trans-fast);
  }

  .site-footer__back-top:hover {
    color: var(--text-primary);
  }

  @media (max-width: 860px) {
    .site-footer__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-8);
    }
    .site-footer__brand-col {
      grid-column: span 2;
    }
  }

  @media (max-width: 520px) {
    .site-footer__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .site-footer__brand-col {
      grid-column: span 1;
    }
  }
</style>
