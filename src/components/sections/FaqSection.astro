---
import Badge from '../ui/Badge.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale?: string;
}

const { locale = 'en' } = Astro.props;

const faqs = [
  {
    q: 'Is my repository code or private Markdown uploaded to any server?',
    a: 'No. 100% of markdown parsing, sanitization, PDF layout, and ZIP packaging happens directly inside your browser memory. md2pdf has zero application backend, zero database, and zero telemetry.',
  },
  {
    q: 'What happens if the GitHub API rate limit is exceeded?',
    a: 'When GitHub unauthenticated API limits are reached, md2pdf automatically falls back to raw content streaming via raw.githubusercontent.com, allowing public READMEs to convert without interruption.',
  },
  {
    q: 'How does the Documentation Book builder work?',
    a: 'The Book builder uses the Git Trees API to scan the repository structure. You can search, filter, and select up to 30 markdown files with tri-state directory checkboxes, reorder the chapter sequence, generate an automatic cover and master table of contents, and print or download a ZIP archive of PDFs.',
  },
  {
    q: 'Are relative images and internal links preserved in the PDF?',
    a: 'Yes! Relative image paths (such as ./assets/screenshot.png) are automatically rewritten to raw.githubusercontent.com pinned to the specific branch or commit SHA, and external links are preserved as clickable PDF URI annotations.',
  },
  {
    q: 'Which languages and Unicode scripts are supported?',
    a: 'md2pdf embeds standalone fonts in the exported PDFs: DejaVu Sans and DejaVu Sans Mono for Latin, Cyrillic, and Turkish, and Noto Sans CJK SC for Chinese, Japanese, and Korean text.',
  },
  {
    q: 'Can I print without creating a PDF file on disk?',
    a: 'Yes. md2pdf features a dedicated browser print isolation engine. Clicking "Print" formats only the styled document sheet with native page breaks, allowing you to use your browser\'s Print dialog to print directly or save as PDF.',
  },
];
---

<section class="faq-section" id="faq">
  <div class="faq-container">
    <div class="faq-header">
      <Badge variant="brand" size="md">Common Questions</Badge>
      <h2 class="faq-title">Frequently Asked Questions</h2>
      <p class="faq-lead">
        Everything you need to know about privacy, GitHub API rate limits, font embedding, and documentation books.
      </p>
    </div>

    <div class="faq-list">
      {
        faqs.map((faq) => (
          <details class="faq-item">
            <summary class="faq-summary">
              <span class="faq-question">{faq.q}</span>
              <span class="faq-icon" aria-hidden="true">
                <Icon name="chevron-down" size={16} />
              </span>
            </summary>
            <div class="faq-answer">
              <p>{faq.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-section {
    padding: var(--sp-20) 0;
    background: var(--bg-surface);
    border-top: 1px solid var(--border-subtle);
  }

  .faq-container {
    max-width: 820px;
    margin: 0 auto;
    padding: 0 var(--container-gutter);
  }

  .faq-header {
    text-align: center;
    margin-bottom: var(--sp-12);
  }

  .faq-title {
    font-size: clamp(28px, 4vw, 40px);
    font-weight: 800;
    letter-spacing: -0.03em;
    color: var(--text-primary);
    margin: var(--sp-3) 0 var(--sp-4);
  }

  .faq-lead {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
    margin: 0;
  }

  .faq-list {
    display: flex;
    flex-direction: column;
    gap: var(--sp-3);
  }

  .faq-item {
    background: var(--bg-elevated);
    border: 1px solid var(--border-subtle);
    border-radius: var(--r-lg);
    overflow: hidden;
    transition: all var(--trans-fast);
  }

  .faq-item[open] {
    border-color: var(--border-medium);
    box-shadow: var(--shadow-subtle);
  }

  .faq-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: var(--sp-5) var(--sp-6);
    cursor: pointer;
    user-select: none;
    font-weight: 600;
    font-size: 16px;
    color: var(--text-primary);
    list-style: none;
  }

  .faq-summary::-webkit-details-marker {
    display: none;
  }

  .faq-summary:hover {
    color: var(--accent-brand);
  }

  .faq-summary:focus-visible {
    outline: 2px solid var(--border-focus);
    outline-offset: -2px;
  }

  .faq-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--text-muted);
    transition: transform var(--trans-base);
    flex-shrink: 0;
    margin-left: var(--sp-4);
  }

  .faq-item[open] .faq-icon {
    transform: rotate(180deg);
    color: var(--accent-brand);
  }

  .faq-answer {
    padding: 0 var(--sp-6) var(--sp-6);
    color: var(--text-secondary);
    font-size: 14.5px;
    line-height: 1.65;
  }

  .faq-answer p {
    margin: 0;
  }
</style>
