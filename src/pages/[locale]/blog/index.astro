---
import BlogIndexPage from '../../../components/BlogIndexPage.astro';
import { PREFIXED_LOCALES } from '../../../i18n/config.js';

export function getStaticPaths() {
  return PREFIXED_LOCALES.map((locale) => ({
    params: { locale },
    props: { locale },
  }));
}

const { locale } = Astro.props;
---

<BlogIndexPage locale={locale} path={Astro.url.pathname} />
