---
import { getCollection } from 'astro:content';
import BlogArticlePage from '../../components/BlogArticlePage.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft && data.locale === 'en');
  return posts.map((post) => ({
    params: { slug: post.data.translationKey },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BlogArticlePage post={post} locale="en" path={Astro.url.pathname} />
